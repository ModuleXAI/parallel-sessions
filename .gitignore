# Phase 3 construction artifacts — NEVER commit.
# See CLAUDE.md §A.10, §A.11, §A.12; Decisions 2.21, 2.23, 2.24; PR-REV-01.

# Coordination runtime state (created by installer, owned by the system).
.coord/

# Hook registrations and local overrides.
.claude/

# Local dev environment — Claude Code skills + agents
# installed by the developer, not ship surface.
.agents/
skills-lock.json

# Construction-time logs and findings.
IMPLEMENTATION_LOG.md
FINDINGS.md

# Phase sign-offs (one per phase, gitignored per A.10).
phase-*-signoff.md

# Phase 0 verification artifact (gitignored per plan §5 Phase 0).
phase0-verification.md

# Phase POCs (e.g., phase-3-poc-mediator-spawn.md). POCs are
# investigative artifacts per CLAUDE.md §A.8; they accumulate findings
# but do NOT ship as production code. Authoritative learnings get
# folded into the corresponding signoff CLAUDE.md / plan-revisions
# updates.
phase-*-poc-*.md

# State-of-system briefings (reporting artifacts, not deliverables).
STATE_OF_SYSTEM.md

# Manual stress test outputs (per-run logs; Phase 7 / T7.08).
scripts/stress_semi_out/
scripts/stress_realistic_out/

# Internal-only material — not part of the public ship surface.
archive/
docs/
future-work/
*future-work/

# Phase ship-gate fixtures + drivers — internal regression-test
# infrastructure. Each scenario is tied to a specific phase
# done-when criterion and uses internal task/PR codes, so the
# layout does not match standard public OSS test conventions.
# Kept locally for maintainer regression runs; not part of the
# public ship surface.
src/tests/fixtures/phase3_ship_gate/
src/tests/fixtures/phase4_ship_gate/
src/tests/fixtures/phase5_ship_gate/
src/tests/fixtures/phase6_ship_gate/
src/tests/fixtures/phase7_ship_gate/
src/tests/manual/phase3_ship_gate.sh
src/tests/manual/phase4_ship_gate.sh
src/tests/manual/phase5_ship_gate.sh
src/tests/manual/phase6_ship_gate.sh
src/tests/manual/phase7_ship_gate.sh

# Secrets / environment files — must NEVER be committed.
.env
.env.local
.env.*.local
.envrc

# IDE / editor configs.
.vscode/
.idea/
*.code-workspace

# Logs, temp files, backups.
*.log
*.tmp
*.bak
*~

# Node (defensive — no current JS deps, but future-proof).
node_modules/

# OS / editor cruft that has no place in VCS.
.DS_Store
Thumbs.db
*.swp
*.swo

# Upstream Codex CLI checkout — kept locally as reference for the
# codex-integration work; not part of the ship surface. ~470M.
codex-ref-repo/
