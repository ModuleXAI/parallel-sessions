#!/usr/bin/env bash
# coord — coordination CLI (Phase 0 slice).
#
# Subcommands implemented in Phase 0:
#   status        — print active sessions, locks, pending self-tasks, validations.
#   health        — installer-level checks (deps, fs, config bounds).
#   log [--tail N] [--kind K] — print recent events.jsonl lines.
#   events --since <iso8601> — dump events after a timestamp.
#   reset [--confirm]        — reset sessions.json (destructive).
#   uninstall [--purge]      — remove hook entries (leaves .coord/ intact
#                              unless --purge).
#   install                  — re-run the installer (delegates to src/install.sh).
#
# Later phases wire in:
#   wait, task-open, self-delegate, tasks, locks, mediate, mediate --retry.

set -euo pipefail

COORD_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COORD_DIR="${COORD_DIR:-$(cd "$COORD_BIN/.." && pwd)}"
# LIB_DIR resolves relative to the bin script's location, not COORD_DIR.
# This lets the CLI work both installed (`.coord/bin/coord` → `.coord/lib/`)
# and from the source tree under tests (`src/bin/coord` → `src/lib/`),
# even when COORD_DIR is overridden to a per-test `.coord/` workspace
# whose `lib/` directory is empty.
LIB_DIR="$(cd "$COORD_BIN/../lib" && pwd)"
export COORD_DIR

# Utilities -----------------------------------------------------------------

die()  { printf 'coord: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

state_file() { printf '%s/sessions.json\n' "$COORD_DIR"; }
events_file() { printf '%s/events.jsonl\n' "$COORD_DIR"; }
config_file() { printf '%s/config.json\n' "$COORD_DIR"; }

cmd_status() {
  if [ ! -f "$(state_file)" ]; then die "no .coord/sessions.json found; run install"; fi
  local reads_detail=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --reads) reads_detail=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  local schema active_count locks wait_q pending_self pending_valid
  schema=$(jq -r '.schema_version' "$(state_file)" 2>/dev/null || printf '?')
  active_count=$(jq -r '[.sessions[]|select(.state=="ACTIVE")]|length' "$(state_file)" 2>/dev/null || printf '0')
  locks=$(jq -r '.locks | length' "$(state_file)" 2>/dev/null || printf '0')
  wait_q=$(jq -r '[.wait_queues[]|length]|add // 0' "$(state_file)" 2>/dev/null || printf '0')
  pending_self=$(jq -r '[.self_tasks[]|length]|add // 0' "$(state_file)" 2>/dev/null || printf '0')
  pending_valid=$(ls "$COORD_DIR/validation" 2>/dev/null | wc -l | tr -d ' ')

  info "coord status  (schema_version=$schema)"
  info "  sessions:"
  jq -r '.sessions | to_entries[] | "    \(.key|.[0:8])  state=\(.value.state)  pid=\(.value.pid)  last=\(.value.last_activity_at)"' "$(state_file)" 2>/dev/null
  if [ "$locks" -gt 0 ]; then
    info "  locks:"
    jq -r '.locks | to_entries[] | "    \(.key)  by=\(.value.session|.[0:8])  since=\(.value.acquired_at)"' "$(state_file)"
  else
    info "  locks: (none)"
  fi
  info "  wait_queues: $wait_q waiter(s)"
  info "  self_tasks:  $pending_self pending"
  info "  validation:  $pending_valid pending"

  # Per-session read-set summary (Phase 1).
  local rs_count
  rs_count=$(jq -r '(.read_sets // {}) | length' "$(state_file)" 2>/dev/null || printf '0')
  if [ "$rs_count" -gt 0 ]; then
    info "  read_sets:"
    jq -r '
      .read_sets
      | to_entries[]
      | (.value.reads // []) as $r
      | "    \(.key|.[0:8])  total=\($r|length)  is_latest=\($r|map(select((.is_latest // false) == true))|length)  head_invalidated=\($r|map(select((.superseded_by_head_change // false) == true))|length)  prompt_invalidated=\($r|map(select((.superseded_by // null) == "new_prompt"))|length)"
    ' "$(state_file)" 2>/dev/null
    if [ "$reads_detail" = "1" ]; then
      info "  read_sets (detail):"
      jq -r '
        .read_sets
        | to_entries[]
        | (.key|.[0:8]) as $sid
        | (.value.reads // [])
        | sort_by(.at // "")
        | reverse
        | .[0:20]
        | map("    " + $sid + "  " + .path
              + "  hash=" + ((.hash // "")[0:12])
              + "  is_latest=" + ((.is_latest // false) | tostring)
              + (if (.superseded_by_head_change // false) then "  HEAD!" else "" end)
              + (if (.superseded_by // null) == "new_prompt" then "  NEW_PROMPT!" else "" end))
        | .[]
      ' "$(state_file)" 2>/dev/null
    fi
  else
    info "  read_sets: (none)"
  fi

  info "  events.jsonl lines: $(wc -l < "$(events_file)" 2>/dev/null | tr -d ' ')"
}

cmd_health() {
  local rc=0
  local missing=()
  for c in jq flock shasum ps git; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    printf 'MISSING_DEPS: %s\n' "${missing[*]}" >&2
    rc=1
  else
    info 'deps OK (jq flock shasum ps git)'
  fi
  if ! command -v perl >/dev/null 2>&1; then
    info 'perl: absent (events will use second precision; see FINDINGS F-009)'
  else
    info 'perl: present (ms timestamps enabled)'
  fi
  if [ -s "$(config_file)" ]; then
    # Validate config bounds (Decision 2.20 + F-008).
    local ttl sus con wait_max
    ttl=$(jq -r '.lock_ttl_seconds' "$(config_file)")
    sus=$(jq -r '.watchdog_suspicion_seconds' "$(config_file)")
    con=$(jq -r '.watchdog_confirm_seconds' "$(config_file)")
    wait_max=$(jq -r '.wait_max_seconds' "$(config_file)")
    if [ "$ttl" -lt 300 ]; then info "BAD: lock_ttl_seconds < 300"; rc=1; fi
    if [ "$sus" -le "$ttl" ]; then info "BAD: watchdog_suspicion_seconds <= lock_ttl_seconds"; rc=1; fi
    if [ "$con" -le "$sus" ]; then info "BAD: watchdog_confirm_seconds <= watchdog_suspicion_seconds"; rc=1; fi
    if [ "$wait_max" -ge 600 ]; then info "BAD: wait_max_seconds >= 600 (Bash-tool ceiling; F-008 / PR-PHASE0-01 D)"; rc=1; fi
    if [ "$wait_max" -lt 30 ];  then info "BAD: wait_max_seconds < 30 (passive wait needs at least one poll cycle; PR-PHASE0-01 D)"; rc=1; fi
    [ "$rc" -eq 0 ] && info 'config bounds OK'
  else
    info "WARN: $(config_file) missing; run install --repair"
    rc=1
  fi

  # F-003 / F-012 hygiene: refuse stray digit-named files at repo root.
  # A bare `9` (instead of `9>"<lock>"`) in a flock invocation creates a
  # 0-byte file named `9` at the working directory. This check makes
  # accidental commits of such artefacts impossible to miss.
  local repo_root stray
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  stray=""
  if [ -d "$repo_root" ]; then
    local f base
    for f in "$repo_root"/*; do
      [ -f "$f" ] || continue
      base=$(basename "$f")
      case "$base" in
        ''|*[!0-9]*) ;;
        *) stray="${stray:+$stray }$base" ;;
      esac
    done
  fi
  if [ -n "$stray" ]; then
    info "BAD: stray digit-named file(s) at repo root: $stray (F-003 anti-pattern; see FINDINGS F-012)"
    rc=1
  fi

  return "$rc"
}

cmd_log() {
  local tail_n=20 kind=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --tail) tail_n="$2"; shift 2 ;;
      --kind) kind="$2";   shift 2 ;;
      *)      die "unknown flag: $1" ;;
    esac
  done
  local src
  src=$(events_file)
  [ -f "$src" ] || die "no events.jsonl yet"
  if [ -n "$kind" ]; then
    jq -c --arg k "$kind" 'select(.kind == $k)' "$src" | tail -n "$tail_n"
  else
    tail -n "$tail_n" "$src"
  fi
}

cmd_events() {
  local since=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ -z "$since" ] && die 'usage: coord events --since <iso8601>'
  jq -c --arg t "$since" 'select(.ts > $t)' "$(events_file)"
}

cmd_reset() {
  local confirm=0
  [ "${1:-}" = "--confirm" ] && confirm=1
  if [ "$confirm" -eq 0 ]; then
    die 'destructive; pass --confirm'
  fi
  # shellcheck disable=SC1091
  . "$LIB_DIR/atomic_write.sh"
  coord_atomic_reset "$(state_file)"
  info 'coord: state reset; old sessions.json archived alongside'
}

cmd_uninstall() {
  local purge=0
  [ "${1:-}" = "--purge" ] && purge=1
  # Delegate the settings cleanup to the in-tree install.sh --uninstall.
  # If src/install.sh is reachable, use it; otherwise strip our hook entries
  # from settings.local.json directly.
  local src_install="$COORD_BIN/../../src/install.sh"
  if [ -x "$src_install" ]; then
    "$src_install" --uninstall
  else
    local repo settings
    repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    settings="$repo/.claude/settings.local.json"
    if [ -f "$settings" ]; then
      local tmp; tmp=$(mktemp)
      # Strip coord-owned entries across ALL events; preserve user entries.
      jq '
        if has("hooks") then
          .hooks |= with_entries(
            .value |= ((. // []) | map(
              .hooks = ((.hooks // []) | map(select(((.command // "") | contains("/.coord/hooks/")) | not)))
            ) | map(select((.hooks // []) | length > 0)))
          )
        else . end' "$settings" >"$tmp" && mv "$tmp" "$settings"
    fi
    info "hook entries removed from $settings"
  fi
  if [ "$purge" -eq 1 ]; then
    info "purge: removing $COORD_DIR"
    if [ -z "${COORD_UNINSTALL_YES:-}" ]; then
      read -r -p "Really delete $COORD_DIR? (type YES): " ans
      [ "$ans" = "YES" ] || die 'purge aborted'
    fi
    rm -rf "$COORD_DIR"
    info "coord: purge complete; IMPLEMENTATION_LOG.md and FINDINGS.md preserved"
  else
    info "coord: uninstall complete; .coord/ left in place. Use 'coord uninstall --purge' to remove it."
  fi
}

cmd_install() {
  local src_install="$COORD_BIN/../../src/install.sh"
  [ -x "$src_install" ] || die "install script not found at $src_install"
  exec "$src_install" "$@"
}

# Phase 2 T2.03: passive wait for a lock to release.
#   coord wait <path> [--timeout N]
# Behavior:
#   - Clamps --timeout to [30, 570] per Decision 2.20 / PR-PHASE0-01;
#     a clamped request emits a WAIT_CLAMPED event with requested + applied.
#   - Polls every 250 ms (4 polls/sec) until either: (a) the lock on
#     <path> is gone or held by THIS session → exit 0, emit WAIT_RELEASED;
#     (b) the timeout deadline is reached → exit 1, emit WAIT_TIMEOUT.
#   - Instant exits without waiting:
#       * file is not locked → exit 0 silently (stdout: "lock free")
#       * file is locked by THIS session → exit 0 silently
#         (you cannot wait on yourself)
#   - SIGINT / SIGTERM trap: emit WAIT_TIMEOUT with reason=interrupted,
#     exit 130 (standard SIGINT exit code) without state corruption.
#   - Subagent policy (A): coord wait works for any caller. The CLI runs
#     in the caller's process and reads sessions.json directly; there is
#     no parent-vs-subagent enforcement here. F-015 captures the
#     alternative (B) for future-Phase-6 review.
cmd_wait() {
  local path="" timeout_req=570
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout)   timeout_req="$2"; shift 2 ;;
      --timeout=*) timeout_req="${1#--timeout=}"; shift ;;
      -*)          die "unknown flag: $1" ;;
      *)           if [ -z "$path" ]; then path="$1"; else die "unexpected arg: $1"; fi; shift ;;
    esac
  done
  [ -z "$path" ] && die 'usage: coord wait <path> [--timeout <30..570>]'

  case "$timeout_req" in
    ''|*[!0-9]*) die "--timeout must be a non-negative integer; got: $timeout_req" ;;
  esac

  # Clamp per Decision 2.20 + PR-PHASE0-01.
  local timeout_applied="$timeout_req" clamped=0
  if [ "$timeout_req" -lt 30 ]; then
    timeout_applied=30; clamped=1
  elif [ "$timeout_req" -gt 570 ]; then
    timeout_applied=570; clamped=1
  fi

  # Resolve session_id for event logging best-effort. The CLI may run
  # outside a hook context, in which case SESSION_ID is unset and
  # log_event will tag events as session=unknown.
  # shellcheck disable=SC1091
  . "$LIB_DIR/log_event.sh"
  # shellcheck disable=SC1091
  . "$LIB_DIR/state_query.sh"
  : "${SESSION_ID:=unknown}"
  export SESSION_ID

  if [ "$clamped" -eq 1 ]; then
    coord_log_event kind=WAIT_CLAMPED file="$path" \
      requested="$timeout_req" applied="$timeout_applied"
  fi

  # Trap SIGINT/SIGTERM for clean exit.
  local started_iso started_epoch interrupted=0
  started_iso=$(coord_now_iso8601)
  started_epoch=$(date -u +%s)
  cleanup_interrupt() {
    interrupted=1
    coord_log_event kind=WAIT_TIMEOUT file="$path" \
      requested="$timeout_req" applied="$timeout_applied" \
      reason=interrupted \
      waited_for=$(( $(date -u +%s) - started_epoch ))
    info "coord wait: interrupted"
    exit 130
  }
  trap cleanup_interrupt INT TERM

  # Instant-exit branches (before any sleep).
  local holder
  holder=$(coord_lock_holder "$path")
  if [ -z "$holder" ]; then
    info "coord wait: lock free on $path"
    return 0
  fi
  if [ "$holder" = "${SESSION_ID}" ]; then
    info "coord wait: lock on $path is held by you (no wait needed)"
    return 0
  fi

  # Poll loop. 250 ms interval = 4 polls/sec; bounded by timeout_applied.
  local deadline=$(( started_epoch + timeout_applied ))
  while :; do
    local now
    now=$(date -u +%s)
    if [ "$now" -ge "$deadline" ]; then
      coord_log_event kind=WAIT_TIMEOUT file="$path" \
        requested="$timeout_req" applied="$timeout_applied" \
        reason=deadline waited_for="$timeout_applied"
      info "coord wait: timeout after ${timeout_applied}s on $path"
      return 1
    fi

    holder=$(coord_lock_holder "$path")
    if [ -z "$holder" ] || [ "$holder" = "${SESSION_ID}" ]; then
      local now_iso waited
      now_iso=$(coord_now_iso8601)
      waited=$(( now - started_epoch ))
      coord_log_event kind=WAIT_RELEASED file="$path" \
        waited_for="$waited" applied="$timeout_applied" \
        started_at="$started_iso" released_at="$now_iso"
      info "coord wait: released after ${waited}s on $path"
      return 0
    fi

    sleep 0.25
  done
}

usage() {
  cat <<'USAGE'
usage: coord <subcommand> [args]

Available subcommands:
  status [--reads]   print active sessions, locks, wait queue, self-tasks,
                     and per-session read-set summary; --reads adds detail
  health             validate deps, fs, config bounds
  log [--tail N] [--kind K]   print recent events.jsonl
  events --since <iso8601>    dump events after a timestamp
  reset --confirm    destructive: reset sessions.json (archives prior state)
  install [flags]    delegate to src/install.sh
  uninstall [--purge]  remove hook entries (and optionally .coord/)
  wait <path> [--timeout N]   block until lock on <path> is released or
                              timeout (clamped to [30, 570] seconds)
  mediate <subcommand>        operator interface to the Mediator agent.
                              Run `coord mediate --help` for details.

Subcommands coming in later phases:
  task-open, self-delegate, tasks, locks, mediate --retry
USAGE
}

sub="${1:-}"
[ -z "$sub" ] && { usage; exit 2; }
shift
case "$sub" in
  status)      cmd_status "$@" ;;
  health)      cmd_health "$@" ;;
  log)         cmd_log "$@" ;;
  events)      cmd_events "$@" ;;
  reset)       cmd_reset "$@" ;;
  install)     cmd_install "$@" ;;
  uninstall)   cmd_uninstall "$@" ;;
  wait)        cmd_wait "$@" ;;
  mediate)
    # Phase 3 T3.08: operator interface to Mediator. Source the
    # required libs lazily so the rest of the CLI doesn't pay for
    # them on unrelated subcommands.
    # shellcheck disable=SC1091
    . "$LIB_DIR/log_event.sh"
    # shellcheck disable=SC1091
    . "$LIB_DIR/mediator_pending.sh"
    # shellcheck disable=SC1091
    . "$LIB_DIR/lockdown.sh"
    # shellcheck disable=SC1091
    . "$LIB_DIR/atomic_write.sh"
    # shellcheck disable=SC1091
    . "$LIB_DIR/verdict_apply.sh"
    # shellcheck disable=SC1091
    . "$LIB_DIR/coord_mediate.sh"
    coord_mediate_dispatch "$@"
    ;;
  help|-h|--help) usage ;;
  task-open|self-delegate)
    # Phase 6 deliverables — currently disabled but emit *educational*
    # guidance so a Claude session that tried option (a) or (b) from the
    # §B.2 deny prompt loses minimum context. Point them at option (c)
    # explicitly with concrete syntax.
    target=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --file) target="${2:-}"; shift 2 ;;
        --file=*) target="${1#--file=}"; shift ;;
        *) shift ;;
      esac
    done
    cat >&2 <<EOF
coord $sub: not yet enabled.

This subcommand is a Phase 6 deliverable (task delegation / self-delegation)
and is intentionally disabled in Phase 2.

Currently-available alternatives:
  (c) Passively wait for the lock to release:
        coord wait${target:+ $target} --timeout 570

  Or, if waiting is too long for this turn:
    - Re-read the file on your next read-set boundary; the lock holder
      may already have released.
    - Switch to editing a different file you are not blocked on.
    - Surface the contention to the user explicitly so they can decide
      whether to pause one of the sessions.

Phase 2 enables only option (c). Options (a) and (b) become available
when Phase 6 lands.
EOF
    exit 1
    ;;
  *)
    # Stubs for Phase N+ subcommands not yet implemented.
    case "$sub" in
      tasks|locks)
        die "subcommand '$sub' is not implemented in Phase 2; wait for the corresponding phase"
        ;;
      *) die "unknown subcommand: $sub" ;;
    esac
    ;;
esac
