#!/usr/bin/env bash
# coord — coordination CLI (Phase 0 slice).
#
# Subcommands implemented in Phase 0:
#   status        — print active sessions, locks, pending self-tasks, validations.
#   health        — installer-level checks (deps, fs, config bounds).
#   log [--tail N] [--kind K] — print recent events.jsonl lines.
#   events --since <iso8601> — dump events after a timestamp.
#   reset [--confirm]        — reset sessions.json (destructive).
#   uninstall [--purge]      — remove hook entries (leaves .coord/ intact
#                              unless --purge).
#   install                  — re-run the installer (delegates to src/install.sh).
#
# Later phases wire in:
#   wait (Phase 5), task-open (Phase 6 T6.03), self-delegate (Phase 6 T6.04),
#   tasks, locks, mediate (Phase 3), mediate --retry.

set -euo pipefail

COORD_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COORD_DIR="${COORD_DIR:-$(cd "$COORD_BIN/.." && pwd)}"
# LIB_DIR resolves relative to the bin script's location, not COORD_DIR.
# Post-A.3 layout puts bin and lib as siblings in both contexts:
#   source tree under tests:  src/core/bin/coord -> src/core/lib/
#   installed by install.sh:  .coord/bin/coord   -> .coord/lib/
# A single `../lib` resolution works in both — the A.1/A.2 dual-fallback
# is no longer needed here (still required for hooks under
# src/adapters/<agent>/hooks/, where core/lib is 3 dirs up in source).
# Tests may also override COORD_DIR to a per-test .coord/ workspace
# whose lib/ may be empty; the bin file is still resolved by absolute
# path from $COORD_BIN, so this works.
LIB_DIR="$(cd "$COORD_BIN/../lib" && pwd)"
export COORD_DIR

# Utilities -----------------------------------------------------------------

die()  { printf 'coord: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

state_file() { printf '%s/sessions.json\n' "$COORD_DIR"; }
events_file() { printf '%s/events.jsonl\n' "$COORD_DIR"; }
config_file() { printf '%s/config.json\n' "$COORD_DIR"; }

cmd_status() {
  if [ ! -f "$(state_file)" ]; then die "no .coord/sessions.json found; run install"; fi
  local reads_detail=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --reads) reads_detail=1; shift ;;
      *) die "unknown flag: $1" ;;
    esac
  done

  local schema active_count locks wait_q pending_self pending_valid
  schema=$(jq -r '.schema_version' "$(state_file)" 2>/dev/null || printf '?')
  active_count=$(jq -r '[.sessions[]|select(.state=="ACTIVE")]|length' "$(state_file)" 2>/dev/null || printf '0')
  locks=$(jq -r '.locks | length' "$(state_file)" 2>/dev/null || printf '0')
  wait_q=$(jq -r '[.wait_queues[]|length]|add // 0' "$(state_file)" 2>/dev/null || printf '0')
  pending_self=$(jq -r '[.self_tasks[]|length]|add // 0' "$(state_file)" 2>/dev/null || printf '0')
  pending_valid=$(ls "$COORD_DIR/validation" 2>/dev/null | wc -l | tr -d ' ')

  info "coord status  (schema_version=$schema)"
  info "  sessions:"
  jq -r '.sessions | to_entries[] | "    \(.key|.[0:8])  state=\(.value.state)  pid=\(.value.pid)  last=\(.value.last_activity_at)"' "$(state_file)" 2>/dev/null
  if [ "$locks" -gt 0 ]; then
    info "  locks:"
    jq -r '.locks | to_entries[] | "    \(.key)  by=\(.value.session|.[0:8])  since=\(.value.acquired_at)"' "$(state_file)"
  else
    info "  locks: (none)"
  fi
  info "  wait_queues: $wait_q waiter(s)"
  info "  self_tasks:  $pending_self pending"
  info "  validation:  $pending_valid pending"

  # Per-session read-set summary (Phase 1).
  local rs_count
  rs_count=$(jq -r '(.read_sets // {}) | length' "$(state_file)" 2>/dev/null || printf '0')
  if [ "$rs_count" -gt 0 ]; then
    info "  read_sets:"
    jq -r '
      .read_sets
      | to_entries[]
      | (.value.reads // []) as $r
      | "    \(.key|.[0:8])  total=\($r|length)  is_latest=\($r|map(select((.is_latest // false) == true))|length)  head_invalidated=\($r|map(select((.superseded_by_head_change // false) == true))|length)  prompt_invalidated=\($r|map(select((.superseded_by // null) == "new_prompt"))|length)"
    ' "$(state_file)" 2>/dev/null
    if [ "$reads_detail" = "1" ]; then
      info "  read_sets (detail):"
      jq -r '
        .read_sets
        | to_entries[]
        | (.key|.[0:8]) as $sid
        | (.value.reads // [])
        | sort_by(.at // "")
        | reverse
        | .[0:20]
        | map("    " + $sid + "  " + .path
              + "  hash=" + ((.hash // "")[0:12])
              + "  is_latest=" + ((.is_latest // false) | tostring)
              + (if (.superseded_by_head_change // false) then "  HEAD!" else "" end)
              + (if (.superseded_by // null) == "new_prompt" then "  NEW_PROMPT!" else "" end))
        | .[]
      ' "$(state_file)" 2>/dev/null
    fi
  else
    info "  read_sets: (none)"
  fi

  info "  events.jsonl lines: $(wc -l < "$(events_file)" 2>/dev/null | tr -d ' ')"
}

cmd_health() {
  local rc=0
  local missing=()
  for c in jq flock shasum ps git; do
    command -v "$c" >/dev/null 2>&1 || missing+=("$c")
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    printf 'MISSING_DEPS: %s\n' "${missing[*]}" >&2
    rc=1
  else
    info 'deps OK (jq flock shasum ps git)'
  fi
  if ! command -v perl >/dev/null 2>&1; then
    info 'perl: absent (events will use second precision; see FINDINGS F-009)'
  else
    info 'perl: present (ms timestamps enabled)'
  fi
  if [ -s "$(config_file)" ]; then
    # Validate config bounds (Decision 2.20 + F-008).
    local ttl sus con wait_max
    ttl=$(jq -r '.lock_ttl_seconds' "$(config_file)")
    sus=$(jq -r '.watchdog_suspicion_seconds' "$(config_file)")
    con=$(jq -r '.watchdog_confirm_seconds' "$(config_file)")
    wait_max=$(jq -r '.wait_max_seconds' "$(config_file)")
    if [ "$ttl" -lt 300 ]; then info "BAD: lock_ttl_seconds < 300"; rc=1; fi
    if [ "$sus" -le "$ttl" ]; then info "BAD: watchdog_suspicion_seconds <= lock_ttl_seconds"; rc=1; fi
    if [ "$con" -le "$sus" ]; then info "BAD: watchdog_confirm_seconds <= watchdog_suspicion_seconds"; rc=1; fi
    if [ "$wait_max" -ge 600 ]; then info "BAD: wait_max_seconds >= 600 (Bash-tool ceiling; F-008 / PR-PHASE0-01 D)"; rc=1; fi
    if [ "$wait_max" -lt 30 ];  then info "BAD: wait_max_seconds < 30 (passive wait needs at least one poll cycle; PR-PHASE0-01 D)"; rc=1; fi
    [ "$rc" -eq 0 ] && info 'config bounds OK'
  else
    info "WARN: $(config_file) missing; run install --repair"
    rc=1
  fi

  # F-003 / F-012 hygiene: refuse stray digit-named files at repo root.
  # A bare `9` (instead of `9>"<lock>"`) in a flock invocation creates a
  # 0-byte file named `9` at the working directory. This check makes
  # accidental commits of such artefacts impossible to miss.
  local repo_root stray
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
  stray=""
  if [ -d "$repo_root" ]; then
    local f base
    for f in "$repo_root"/*; do
      [ -f "$f" ] || continue
      base=$(basename "$f")
      case "$base" in
        ''|*[!0-9]*) ;;
        *) stray="${stray:+$stray }$base" ;;
      esac
    done
  fi
  if [ -n "$stray" ]; then
    info "BAD: stray digit-named file(s) at repo root: $stray (F-003 anti-pattern; see FINDINGS F-012)"
    rc=1
  fi

  return "$rc"
}

cmd_log() {
  local tail_n=20 kind=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --tail) tail_n="$2"; shift 2 ;;
      --kind) kind="$2";   shift 2 ;;
      *)      die "unknown flag: $1" ;;
    esac
  done
  local src
  src=$(events_file)
  [ -f "$src" ] || die "no events.jsonl yet"
  if [ -n "$kind" ]; then
    jq -c --arg k "$kind" 'select(.kind == $k)' "$src" | tail -n "$tail_n"
  else
    tail -n "$tail_n" "$src"
  fi
}

cmd_events() {
  local since=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --since) since="$2"; shift 2 ;;
      *) die "unknown flag: $1" ;;
    esac
  done
  [ -z "$since" ] && die 'usage: coord events --since <iso8601>'
  jq -c --arg t "$since" 'select(.ts > $t)' "$(events_file)"
}

cmd_reset() {
  local confirm=0
  [ "${1:-}" = "--confirm" ] && confirm=1
  if [ "$confirm" -eq 0 ]; then
    die 'destructive; pass --confirm'
  fi
  # shellcheck disable=SC1091
  . "$LIB_DIR/atomic_write.sh"
  coord_atomic_reset "$(state_file)"
  info 'coord: state reset; old sessions.json archived alongside'
}

cmd_uninstall() {
  local purge=0
  [ "${1:-}" = "--purge" ] && purge=1
  # Delegate the settings cleanup to the in-tree install.sh --uninstall.
  # If src/install.sh is reachable, use it; otherwise strip our hook entries
  # from settings.local.json directly.
  local src_install="$COORD_BIN/../../src/install.sh"
  if [ -x "$src_install" ]; then
    "$src_install" --uninstall
  else
    local repo settings
    repo=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
    settings="$repo/.claude/settings.local.json"
    if [ -f "$settings" ]; then
      local tmp; tmp=$(mktemp)
      # Strip coord-owned entries across ALL events; preserve user entries.
      jq '
        if has("hooks") then
          .hooks |= with_entries(
            .value |= ((. // []) | map(
              .hooks = ((.hooks // []) | map(select(((.command // "") | contains("/.coord/hooks/")) | not)))
            ) | map(select((.hooks // []) | length > 0)))
          )
        else . end' "$settings" >"$tmp" && mv "$tmp" "$settings"
    fi
    info "hook entries removed from $settings"
  fi
  if [ "$purge" -eq 1 ]; then
    info "purge: removing $COORD_DIR"
    if [ -z "${COORD_UNINSTALL_YES:-}" ]; then
      read -r -p "Really delete $COORD_DIR? (type YES): " ans
      [ "$ans" = "YES" ] || die 'purge aborted'
    fi
    rm -rf "$COORD_DIR"
    info "coord: purge complete; IMPLEMENTATION_LOG.md and FINDINGS.md preserved"
  else
    info "coord: uninstall complete; .coord/ left in place. Use 'coord uninstall --purge' to remove it."
  fi
}

cmd_install() {
  local src_install="$COORD_BIN/../../src/install.sh"
  [ -x "$src_install" ] || die "install script not found at $src_install"
  exec "$src_install" "$@"
}

# Phase 2 T2.03 + Phase 5 T5.03: passive wait for a lock to release.
#   coord wait <path> [--timeout N]
# Behavior (Phase 5 / PR-PHASE5-02):
#   - Clamps --timeout to [30, 570] per Decision 2.20 / PR-PHASE0-01;
#     a clamped request emits a WAIT_CLAMPED event with requested + applied.
#   - Phase 5 event-driven flow:
#       1. Enqueue self into wait_queues[<path>] via lib/wait_queue.sh;
#          obtain the wake_file path that the lock-release-side producer
#          will write to.
#       2. Dispatch on .config.json wait_backend (fswatch / inotifywait /
#          250 ms polling fallback per PR-PHASE5-02 §4); first invocation
#          per process emits WAIT_BACKEND.
#       3. On wake-up, read wake_file content with 50 ms grace re-read
#          and "modified by <unknown>" empty-fallback (pin-point c-3).
#       4. Dequeue self; print diff_summary on stdout for caller.
#   - Instant exits without waiting:
#       * file is not locked → exit 0 silently (stdout: "lock free")
#       * file is locked by THIS session → exit 0 silently
#   - SIGINT / SIGTERM trap: emit WAIT_TIMEOUT with reason=interrupted,
#     exit 130 (standard SIGINT exit code); SIGINT cleanup dequeues
#     the waiter from the queue + kills any backend watcher pid.
#   - Subagent policy (A): coord wait works for any caller. F-015
#     captures the alternative (B) for Phase 6 review.
cmd_wait() {
  local path="" timeout_req=570
  while [ $# -gt 0 ]; do
    case "$1" in
      --timeout)   timeout_req="$2"; shift 2 ;;
      --timeout=*) timeout_req="${1#--timeout=}"; shift ;;
      -*)          die "unknown flag: $1" ;;
      *)           if [ -z "$path" ]; then path="$1"; else die "unexpected arg: $1"; fi; shift ;;
    esac
  done
  [ -z "$path" ] && die 'usage: coord wait <path> [--timeout <30..570>]'

  case "$timeout_req" in
    ''|*[!0-9]*) die "--timeout must be a non-negative integer; got: $timeout_req" ;;
  esac

  # Clamp per Decision 2.20 + PR-PHASE0-01.
  local timeout_applied="$timeout_req" clamped=0
  if [ "$timeout_req" -lt 30 ]; then
    timeout_applied=30; clamped=1
  elif [ "$timeout_req" -gt 570 ]; then
    timeout_applied=570; clamped=1
  fi

  # shellcheck disable=SC1091
  . "$LIB_DIR/atomic_write.sh"
  # shellcheck disable=SC1091
  . "$LIB_DIR/log_event.sh"
  # shellcheck disable=SC1091
  . "$LIB_DIR/state_query.sh"
  # shellcheck disable=SC1091
  . "$LIB_DIR/wait_queue.sh"
  # shellcheck disable=SC1091
  . "$LIB_DIR/wait_backend.sh"

  : "${SESSION_ID:=coord-wait-$$}"
  export SESSION_ID

  if [ "$clamped" -eq 1 ]; then
    coord_log_event kind=WAIT_CLAMPED file="$path" \
      requested="$timeout_req" applied="$timeout_applied"
  fi

  local started_iso started_epoch
  started_iso=$(coord_now_iso8601)
  started_epoch=$(date -u +%s)

  # Instant-exit branches (before any enqueue / wake_file work).
  local holder
  holder=$(coord_lock_holder "$path")
  if [ -z "$holder" ]; then
    info "coord wait: lock free on $path"
    return 0
  fi
  if [ "$holder" = "${SESSION_ID}" ]; then
    info "coord wait: lock on $path is held by you (no wait needed)"
    return 0
  fi

  # Phase 5 enqueue. Returns the wake_file path that the lock-release
  # producer will write to. Idempotent: re-issuing coord wait for the
  # same (sid, path) returns the existing wake_file.
  local wake_file
  if ! wake_file=$(coord_wait_queue_enqueue "$SESSION_ID" "$path"); then
    info "coord wait: failed to enqueue on $path (wait_queue rc=$?)" >&2
    return 1
  fi

  # SIGINT/SIGTERM trap: dequeue self + kill any backend watcher pid.
  # Phase 7 / T7.06a (F-016 fix):
  #   1. Use coord_log_event_sync (NOT async) so events.jsonl write
  #      completes before exit 130 fires; closes the
  #      backgrounded-flush race documented in F-016 audit.
  #   2. Explicitly kill _COORD_WAIT_FSWATCH_PID + _COORD_WAIT_SLEEPER_PID
  #      (set by coord_wait_for_release_fswatch) before exit so the
  #      child watchers don't orphan to PID 1.
  cleanup_interrupt() {
    if [ -n "${_COORD_WAIT_FSWATCH_PID:-}" ]; then
      kill -TERM "$_COORD_WAIT_FSWATCH_PID" 2>/dev/null || true
    fi
    if [ -n "${_COORD_WAIT_SLEEPER_PID:-}" ]; then
      kill -TERM "$_COORD_WAIT_SLEEPER_PID" 2>/dev/null || true
    fi
    coord_log_event_sync kind=WAIT_TIMEOUT file="$path" \
      requested="$timeout_req" applied="$timeout_applied" \
      reason=interrupted \
      waited_for=$(( $(date -u +%s) - started_epoch ))
    coord_wait_queue_dequeue "$SESSION_ID" "$path" 2>/dev/null || true
    info "coord wait: interrupted"
    exit 130
  }
  trap cleanup_interrupt INT TERM

  # Backend dispatch. coord_wait_for_release reads the resolved
  # wait_backend from .coord/config.json and runs the matching
  # event-driven wait loop. First-use event is emitted once per shell
  # process.
  local backend
  backend=$(coord_wait_backend_get)
  coord_wait_emit_first_use_event "$backend"

  if coord_wait_for_release "$wake_file" "$timeout_applied"; then
    # Wake-up event observed. Read wake_file content (50 ms grace +
    # "modified by <unknown>" empty fallback per PR-PHASE5-02 §3).
    local diff_summary now_iso waited
    diff_summary=$(coord_wait_read_content "$wake_file" "${holder:0:8}")
    now_iso=$(coord_now_iso8601)
    waited=$(( $(date -u +%s) - started_epoch ))
    coord_log_event kind=WAIT_RELEASED file="$path" \
      waited_for="$waited" applied="$timeout_applied" \
      backend="$backend" \
      started_at="$started_iso" released_at="$now_iso"
    coord_wait_queue_dequeue "$SESSION_ID" "$path" 2>/dev/null || true
    # Print diff_summary on stdout for caller's additionalContext.
    info "coord wait: released after ${waited}s on $path"
    info "$diff_summary"
    return 0
  fi

  # Timeout.
  coord_log_event kind=WAIT_TIMEOUT file="$path" \
    requested="$timeout_req" applied="$timeout_applied" \
    reason=deadline waited_for="$timeout_applied" backend="$backend"
  coord_wait_queue_dequeue "$SESSION_ID" "$path" 2>/dev/null || true
  info "coord wait: timeout after ${timeout_applied}s on $path"
  return 1
}

# cmd_task_open --file <path> --complexity <SIMPLE|MODERATE|COMPLEX>
#               --anchor '<json>' --instruction '<text>' [--rationale '<text>']
#
# Phase 6 T6.03: persists a task into locks[<file>].tasks[] for the
# lock-holder to process at release time. CLI-level rejection paths
# preserve the 2-location deny invariant (Decision 6) — chain depth /
# cycle / anchor uniqueness / toggle disabled all exit 1 with stderr,
# never permissionDecision.
#
# Per PR-PHASE6-05 §1-§7 + ambiguity dispositions A (--rationale
# optional) and B (file-not-exists → "anchor not found").
#
# Persisted task record schema (PR-PHASE6-05 §7):
#   task_id, opener, file, instruction, complexity, anchor,
#   rationale (nullable), created_at, affected_lines_at_open,
#   status=PENDING, outcome_diff/rationale/at (null until completion).
cmd_task_open() {
  local file="" complexity="" anchor_json="" instruction="" rationale=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --file)         file="${2:-}"; shift 2 ;;
      --file=*)       file="${1#--file=}"; shift ;;
      --complexity)   complexity="${2:-}"; shift 2 ;;
      --complexity=*) complexity="${1#--complexity=}"; shift ;;
      --anchor)       anchor_json="${2:-}"; shift 2 ;;
      --anchor=*)     anchor_json="${1#--anchor=}"; shift ;;
      --instruction)  instruction="${2:-}"; shift 2 ;;
      --instruction=*) instruction="${1#--instruction=}"; shift ;;
      --rationale)    rationale="${2:-}"; shift 2 ;;
      --rationale=*)  rationale="${1#--rationale=}"; shift ;;
      -*)             die "unknown flag: $1" ;;
      *)              die "unexpected arg: $1" ;;
    esac
  done

  # Required-flag validation.
  [ -z "$file" ]        && die 'usage: coord task-open --file <path> --complexity SIMPLE|MODERATE|COMPLEX --anchor <json> --instruction <text> [--rationale <text>]'
  [ -z "$complexity" ]  && die '--complexity is required (SIMPLE|MODERATE|COMPLEX)'
  [ -z "$anchor_json" ] && die '--anchor is required'
  [ -z "$instruction" ] && die '--instruction is required'

  # Complexity enum validation.
  case "$complexity" in
    SIMPLE|MODERATE|COMPLEX) ;;
    *) printf 'Error: invalid complexity (must be SIMPLE/MODERATE/COMPLEX)\n' >&2
       return 1 ;;
  esac

  # task_delegation toggle check (config.json). Default true if config
  # is missing or field absent (graceful degradation). NOTE: jq's `//`
  # operator triggers on BOTH null AND false (jq spec: "alternative"
  # operator returns RHS when LHS is null or false). So
  # `.task_delegation // true` returns `true` when the value IS
  # literally `false` — which would silently bypass the toggle check.
  # Use explicit `has(...)` to distinguish absent-key from
  # present-and-false.
  local toggle="true"
  if [ -f "$(config_file)" ]; then
    if toggle_raw=$(jq -r 'if has("task_delegation") then .task_delegation else true end' "$(config_file)" 2>/dev/null); then
      toggle="$toggle_raw"
    fi
  fi
  if [ "$toggle" != "true" ]; then
    printf 'Error: task_delegation disabled per repo (config.json task_delegation: false)\n' >&2
    return 1
  fi

  # Anchor JSON parse + key validation.
  local anchor_search anchor_window
  if ! anchor_search=$(printf '%s' "$anchor_json" | jq -r '.search // empty' 2>/dev/null); then
    printf 'Error: invalid --anchor JSON (jq parse failed)\n' >&2
    return 1
  fi
  if [ -z "$anchor_search" ]; then
    printf 'Error: --anchor missing required key "search"\n' >&2
    return 1
  fi
  anchor_window=$(printf '%s' "$anchor_json" | jq -r '.window_lines // empty' 2>/dev/null)
  if [ -z "$anchor_window" ]; then
    printf 'Error: --anchor missing required key "window_lines"\n' >&2
    return 1
  fi
  # window_lines: "<start>-<end>" range, integers, start <= end.
  case "$anchor_window" in
    *-*) ;;
    *)   printf 'Error: --anchor.window_lines must be range "start-end" (e.g. "42-67")\n' >&2
         return 1 ;;
  esac
  local win_start="${anchor_window%-*}"
  local win_end="${anchor_window#*-}"
  case "$win_start" in
    ''|*[!0-9]*) printf 'Error: --anchor.window_lines start must be an integer; got: %s\n' "$win_start" >&2; return 1 ;;
  esac
  case "$win_end" in
    ''|*[!0-9]*) printf 'Error: --anchor.window_lines end must be an integer; got: %s\n' "$win_end" >&2; return 1 ;;
  esac
  if [ "$win_start" -gt "$win_end" ]; then
    printf 'Error: --anchor.window_lines start (%s) must be <= end (%s)\n' "$win_start" "$win_end" >&2
    return 1
  fi

  # Anchor uniqueness check (ambiguity B: file-not-exists OR 0 matches
  # both unify under "anchor not found"). grep -F for fixed-string
  # match; -c counts. CLAUDE.md §A.13 lesson #5: `if var=$(cmd)` for
  # rc capture under set -e + pipefail. The `var=$(cmd) || printf '0'`
  # form is broken — `||` runs INSIDE the command substitution and
  # APPENDS its stdout to grep's existing "0" output, producing
  # "0\n0" which fails [-gt] integer comparison.
  local match_count
  if [ ! -f "$file" ]; then
    printf 'Error: anchor not found in %s\n' "$file" >&2
    return 1
  fi
  if match_count=$(grep -F -c -- "$anchor_search" "$file" 2>/dev/null); then
    : # rc 0: grep found ≥1 match; match_count holds the count
  else
    : # rc 1 (no match) → match_count="0" from stdout already;
      # rc 2 (read error) → match_count may be "" — sanitize below
    :
  fi
  case "$match_count" in
    ''|*[!0-9]*) match_count=0 ;;
  esac
  if [ "$match_count" = "0" ]; then
    printf 'Error: anchor not found in %s\n' "$file" >&2
    return 1
  fi
  if [ "$match_count" -gt 1 ]; then
    printf 'Error: anchor matches %s candidates (expected 1)\n' "$match_count" >&2
    return 1
  fi

  # Resolve session ID (caller supplies via SESSION_ID env; fall back
  # to a deterministic synthetic id if absent — matches cmd_wait's
  # discipline).
  : "${SESSION_ID:=coord-task-open-$$}"
  export SESSION_ID

  # shellcheck disable=SC1091
  . "$LIB_DIR/atomic_write.sh"
  # shellcheck disable=SC1091
  . "$LIB_DIR/log_event.sh"
  # shellcheck disable=SC1091
  . "$LIB_DIR/cycle_detection.sh"

  # Chain depth + task_graph cycle check (T6.02 lib function).
  # rc 0 ok / rc 1 chain_depth_exceeded / rc 2 task_cycle_detected /
  # rc 3 usage error. stderr from the lib surfaces verbatim to caller.
  local cycle_rc=0
  if coord_cycle_detect_task_graph "$SESSION_ID" "$file"; then
    cycle_rc=0
  else
    cycle_rc=$?
  fi
  if [ "$cycle_rc" -ne 0 ]; then
    return 1
  fi

  # task_id synthesis (PR-PHASE6-05 §4 + Q4 pattern reused for tasks).
  local created_at_ms random_4_hex task_id
  created_at_ms=$(perl -MTime::HiRes=time -e 'printf "%d\n", time*1000' 2>/dev/null || date -u +%s000)
  if random_4_hex=$(openssl rand -hex 2 2>/dev/null); then
    :
  else
    random_4_hex=$(printf '%04x' $((RANDOM*RANDOM)) | tail -c 4)
  fi
  task_id="${SESSION_ID}-task-${created_at_ms}-${random_4_hex}"

  # ISO8601 ms timestamp for created_at.
  local created_at_iso
  if command -v coord_now_iso8601 >/dev/null 2>&1; then
    created_at_iso=$(coord_now_iso8601)
  else
    created_at_iso=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  fi

  # Persist into locks[<file>].tasks[] via atomic_write. The lock must
  # already exist (the holder acquired it via pre_tool_use_write); if
  # absent, we surface a clean error rather than silently materialize
  # the lock entry.
  local state="$COORD_DIR/sessions.json"
  if [ ! -f "$state" ]; then
    die 'no .coord/sessions.json found; run install'
  fi
  local lock_present
  lock_present=$(jq -r --arg f "$file" '.locks[$f].session // ""' "$state" 2>/dev/null)
  if [ -z "$lock_present" ]; then
    printf 'Error: file %s is not currently locked; nothing to delegate to\n' "$file" >&2
    return 1
  fi

  # Task record per PR-PHASE6-05 §7. Optional rationale persisted as
  # null when caller omits the flag.
  if ! coord_atomic_edit "$state" \
       '.locks[$f].tasks += [{
          task_id: $tid,
          opener: $op,
          file: $f,
          instruction: $instr,
          complexity: $cx,
          anchor: {search: $asearch, window_lines: $awin},
          rationale: (if $rat == "" then null else $rat end),
          created_at: $cat,
          affected_lines_at_open: [($wstart|tonumber), ($wend|tonumber)],
          status: "PENDING",
          outcome_diff: null,
          outcome_rationale: null,
          outcome_at: null
        }]' \
       --arg f "$file" \
       --arg tid "$task_id" \
       --arg op "$SESSION_ID" \
       --arg instr "$instruction" \
       --arg cx "$complexity" \
       --arg asearch "$anchor_search" \
       --arg awin "$anchor_window" \
       --arg rat "$rationale" \
       --arg cat "$created_at_iso" \
       --arg wstart "$win_start" \
       --arg wend "$win_end"; then
    printf 'Error: failed to persist task to locks[%s].tasks[]\n' "$file" >&2
    return 1
  fi

  coord_log_event kind=TASK_OPENED \
    file="$file" \
    task_id="$task_id" \
    opener="$SESSION_ID" \
    complexity="$complexity" \
    anchor_window="$anchor_window" \
    has_rationale=$([ -n "$rationale" ] && printf 1 || printf 0) \
    2>/dev/null || true

  info "coord task-open: task created"
  info "  task_id:    $task_id"
  info "  file:       $file"
  info "  complexity: $complexity"
  info "  anchor:     $anchor_search [$anchor_window]"
  return 0
}

# cmd_self_delegate --file <path> --instruction <text>
#
# Phase 6 T6.04: persists a self-task into self_tasks[<sid>] for B's
# session to act on later (when the file becomes unlocked or when B
# notices the reminder injected by pre_tool_use_any.sh / blocks Stop
# per stop.sh — both wired in T6.06/T6.07).
#
# task_delegation toggle does NOT gate self-delegate (option (b) of
# the §B.2 deny banner is always available per Decision 6 toggle-
# FALSE banner; only option (a) coord task-open is gated). Caller's
# session id from $SESSION_ID env (with synthetic fallback parallel
# to cmd_wait + cmd_task_open).
cmd_self_delegate() {
  local file="" instruction=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --file)         file="${2:-}"; shift 2 ;;
      --file=*)       file="${1#--file=}"; shift ;;
      --instruction)  instruction="${2:-}"; shift 2 ;;
      --instruction=*) instruction="${1#--instruction=}"; shift ;;
      -*)             die "unknown flag: $1" ;;
      *)              die "unexpected arg: $1" ;;
    esac
  done

  [ -z "$file" ]        && die 'usage: coord self-delegate --file <path> --instruction <text>'
  [ -z "$instruction" ] && die '--instruction is required'

  # Absolute-path requirement (per T6.04 user binding). Relative
  # paths would round-trip through self_tasks differently across
  # sessions (e.g., when notifications surface in a session whose
  # cwd differs). Reject up-front with clear error.
  case "$file" in
    /*) ;;
    *)  printf 'Error: --file must be an absolute path; got: %s\n' "$file" >&2
        return 1 ;;
  esac

  : "${SESSION_ID:=coord-self-delegate-$$}"
  export SESSION_ID

  # shellcheck disable=SC1091
  . "$LIB_DIR/atomic_write.sh"
  # shellcheck disable=SC1091
  . "$LIB_DIR/log_event.sh"
  # shellcheck disable=SC1091
  . "$LIB_DIR/self_tasks.sh"

  local prompt_id
  if ! prompt_id=$(coord_self_task_open "$SESSION_ID" "$file" "$instruction"); then
    printf 'Error: failed to persist self-task (rc=%s)\n' "$?" >&2
    return 1
  fi

  info "coord self-delegate: self-task created"
  info "  prompt_id:   $prompt_id"
  info "  file:        $file"
  info "  instruction: $instruction"
  info "Reminder will inject when this file is unlocked (per Decision 2.13)."
  return 0
}

usage() {
  cat <<'USAGE'
usage: coord <subcommand> [args]

Available subcommands:
  status [--reads]   print active sessions, locks, wait queue, self-tasks,
                     and per-session read-set summary; --reads adds detail
  health             validate deps, fs, config bounds
  log [--tail N] [--kind K]   print recent events.jsonl
  events --since <iso8601>    dump events after a timestamp
  reset --confirm    destructive: reset sessions.json (archives prior state)
  install [flags]    delegate to src/install.sh
  uninstall [--purge]  remove hook entries (and optionally .coord/)
  wait <path> [--timeout N]   block until lock on <path> is released or
                              timeout (clamped to [30, 570] seconds)
  task-open --file <p> --complexity SIMPLE|MODERATE|COMPLEX
            --anchor <json> --instruction <text> [--rationale <text>]
                              delegate a task to the lock-holder of <p>;
                              processed at lock release (Phase 6 T6.03)
  self-delegate --file <p> --instruction <text>
                              defer your own work on <p>; reminder injects
                              when <p> becomes unlocked (Phase 6 T6.04)
  mediate <subcommand>        operator interface to the Mediator agent.
                              Run `coord mediate --help` for details.

Subcommands coming in later phases:
  tasks, locks, mediate --retry
USAGE
}

sub="${1:-}"
[ -z "$sub" ] && { usage; exit 2; }
shift
case "$sub" in
  status)      cmd_status "$@" ;;
  health)      cmd_health "$@" ;;
  log)         cmd_log "$@" ;;
  events)      cmd_events "$@" ;;
  reset)       cmd_reset "$@" ;;
  install)     cmd_install "$@" ;;
  uninstall)   cmd_uninstall "$@" ;;
  wait)        cmd_wait "$@" ;;
  mediate)
    # Phase 3 T3.08: operator interface to Mediator. Source the
    # required libs lazily so the rest of the CLI doesn't pay for
    # them on unrelated subcommands.
    # shellcheck disable=SC1091
    . "$LIB_DIR/log_event.sh"
    # shellcheck disable=SC1091
    . "$LIB_DIR/mediator_pending.sh"
    # shellcheck disable=SC1091
    . "$LIB_DIR/lockdown.sh"
    # shellcheck disable=SC1091
    . "$LIB_DIR/atomic_write.sh"
    # shellcheck disable=SC1091
    . "$LIB_DIR/verdict_apply.sh"
    # shellcheck disable=SC1091
    . "$LIB_DIR/coord_mediate.sh"
    coord_mediate_dispatch "$@"
    ;;
  help|-h|--help) usage ;;
  task-open)   cmd_task_open "$@" ;;
  self-delegate) cmd_self_delegate "$@" ;;
  *)
    # Stubs for Phase N+ subcommands not yet implemented.
    case "$sub" in
      tasks|locks)
        die "subcommand '$sub' is not implemented in Phase 2; wait for the corresponding phase"
        ;;
      *) die "unknown subcommand: $sub" ;;
    esac
    ;;
esac
